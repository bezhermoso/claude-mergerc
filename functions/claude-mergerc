#!/usr/bin/env zsh
# claude-mergerc
# Merge Claude Code settings fragments with interactive diff/apply.
# https://github.com/bezhermoso/claude-mergerc

function _claude_mergerc_usage() {
  cat <<'EOF'
Usage: claude-mergerc [-d DIR]... [-i GLOB]... [-x GLOB]... [-y] [-c] [-h]

Merge Claude Code settings fragments into ~/.claude/settings.json.

Modes:
  (default) Show a diff of settings.json vs the merged fragments, then apply.
  -c        Check for drift: list every place settings.json differs from the
            merged fragments. Changes nothing. Exits 1 if there is drift.

Options:
  -d DIR    Fragments directory (repeatable). Extends CLAUDE_MERGERC_FRAGMENTS_DIR.
  -i GLOB   Include pattern — filename glob (repeatable). Extends CLAUDE_MERGERC_INCLUDE.
            Default: *.json, *.yaml, *.yml
  -x GLOB   Exclude pattern — filename glob (repeatable). Extends CLAUDE_MERGERC_EXCLUDE.
  -y        YAML mode: stage the merged config as YAML, show the diff in YAML,
            and open YAML buffers for manual merge. Output is still JSON.
  -h        Show this help.

Environment (colon-separated lists):
  CLAUDE_MERGERC_FRAGMENTS_DIR  Dirs. Default: ${XDG_CONFIG_HOME:-~/.config}/claude/fragments
  CLAUDE_MERGERC_INCLUDE        Include globs. Default: *.json:*.yaml:*.yml
  CLAUDE_MERGERC_EXCLUDE        Exclude globs.
  CLAUDE_MERGERC_OUTPUT         Output file. Default: ~/.claude/settings.json
  CLAUDE_MERGERC_YAML           Set to 1 to enable YAML mode (same as -y).

YAML fragments and YAML mode require yq (https://github.com/mikefarah/yq).

Dirs are processed in order; within each dir, files are sorted by basename.
Later files override earlier ones for deep-merged values.

If the output path is a symlink to a regular file, the link is followed and
its target is overwritten (standard dotfile-manager behavior). Symlinks to
directories, broken symlinks, and non-regular files are rejected.
EOF
}

function _claude_mergerc_require_yq() {
  if ! command -v yq &>/dev/null; then
    echo "error: yq is required for YAML support but not found in PATH" >&2
    echo "       install: https://github.com/mikefarah/yq" >&2
    return 1
  fi
  if ! yq --version 2>/dev/null | grep -q mikefarah; then
    echo "error: incompatible yq found; mikefarah/yq v4+ is required for YAML support" >&2
    echo "       install: https://github.com/mikefarah/yq" >&2
    return 1
  fi
}

# Shared jq definitions: the merge itself, plus the drift model.
function _claude_mergerc_jqlib() {
  cat <<'EOF'
def deep_merge(a; b):
  a as $a | b as $b |
  if ($a | type) == "object" and ($b | type) == "object" then
    ($a | keys) + ($b | keys) | unique | map(
      . as $k |
      if ($a | has($k)) and ($b | has($k)) then
        {($k): deep_merge($a[$k]; $b[$k])}
      elif ($b | has($k)) then {($k): $b[$k]}
      else {($k): $a[$k]}
      end
    ) | add // {}
  elif ($a | type) == "array" and ($b | type) == "array" then
    $a + $b | unique
  else $b
  end;

# Arrays merge as sets, so compare them as sets.
def canon: walk(if type == "array" then unique else . end);

def pathstr:
  if length == 0 then "."
  else map(
    if type == "string" and test("^[A-Za-z_][A-Za-z0-9_]*$") then "." + .
    else "[" + tojson + "]"
    end) | join("")
  end;

def haspath($p):
  if ($p | length) == 0 then true
  else try (getpath($p[:-1]) | type == "object" and has($p[-1])) catch false
  end;

def arrayat($p): try (getpath($p) | if type == "array" then . else null end) catch null;

# One item per leaf where $c (settings.json) differs from $m (merged
# fragments). Arrays are treated as sets: each element present on only one
# side is its own item.
def drift_items($c; $m; $p):
  if ($c | type) == "object" and ($m | type) == "object" then
    (($c | keys) + ($m | keys) | unique)[] as $k
    | if ($c | has($k)) and ($m | has($k)) then drift_items($c[$k]; $m[$k]; $p + [$k])
      elif ($c | has($k)) then {kind: "added", path: ($p + [$k]), current: $c[$k]}
      else {kind: "removed", path: ($p + [$k]), merged: $m[$k]}
      end
  elif ($c | type) == "array" and ($m | type) == "array" then
    (($c | unique)[] as $e | select(any($m[]; . == $e) | not)
      | {kind: "array-add", path: $p, value: $e}),
    (($m | unique)[] as $e | select(any($c[]; . == $e) | not)
      | {kind: "array-remove", path: $p, value: $e})
  elif $c == $m then empty
  else {kind: "changed", path: $p, current: $c, merged: $m}
  end;

EOF
}

# Print a fragment as JSON. An empty YAML file reads as {} rather than null.
function _claude_mergerc_to_json() {
  if [[ "$1" == *.(yaml|yml) ]]; then
    yq -o=json '. // {}' "$1"
  else
    jq '.' "$1"
  fi
}

# _claude_mergerc_merge OUT FILE... — deep-merge fragments (in order) into OUT.
function _claude_mergerc_merge() {
  local out="$1"; shift
  local -a inputs
  local f n=0 converted
  for f in "$@"; do
    if [[ "$f" == *.(yaml|yml) ]]; then
      converted="${out:h}/.yaml-to-json-$((++n)).json"
      if ! _claude_mergerc_to_json "$f" > "$converted"; then
        echo "error: failed to parse YAML fragment: $f" >&2
        return 1
      fi
      inputs+=("$converted")
    else
      inputs+=("$f")
    fi
  done
  jq -s "$(_claude_mergerc_jqlib)"' reduce .[] as $item ({}; deep_merge(.; $item))' \
    "${inputs[@]}" > "$out"
}

function _claude_mergerc_show_diff() {
  if command -v delta &>/dev/null; then
    delta "$1" "$2" --pager=never || true
  elif command -v colordiff &>/dev/null; then
    colordiff "$1" "$2" || true
  else
    diff --color=auto -u "$1" "$2" || true
  fi
}

# Does a fragment basename match the include/exclude patterns in scope?
function _claude_mergerc_matches() {
  local fname="$1" pat
  local included=0
  for pat in "${include_patterns[@]}"; do
    if [[ "$fname" == ${~pat} ]]; then included=1; break; fi
  done
  (( included )) || return 1
  for pat in "${exclude_patterns[@]}"; do
    if [[ "$fname" == ${~pat} ]]; then return 1; fi
  done
  return 0
}

function claude-mergerc() {
  emulate -L zsh
  setopt local_options err_return no_unset pipe_fail

  local output="${CLAUDE_MERGERC_OUTPUT:-$HOME/.claude/settings.json}"
  local yaml_mode=0 mode=apply
  [[ "${CLAUDE_MERGERC_YAML:-}" == (1|true|yes) ]] && yaml_mode=1

  local -a fragment_dirs include_patterns exclude_patterns
  if [[ -n "${CLAUDE_MERGERC_FRAGMENTS_DIR:-}" ]]; then
    fragment_dirs=("${(@s/:/)CLAUDE_MERGERC_FRAGMENTS_DIR}")
  else
    fragment_dirs=("${XDG_CONFIG_HOME:-$HOME/.config}/claude/fragments")
  fi
  [[ -n "${CLAUDE_MERGERC_INCLUDE:-}" ]] && include_patterns=("${(@s/:/)CLAUDE_MERGERC_INCLUDE}")
  [[ -n "${CLAUDE_MERGERC_EXCLUDE:-}" ]] && exclude_patterns=("${(@s/:/)CLAUDE_MERGERC_EXCLUDE}")

  local OPTARG OPTIND opt
  OPTIND=1
  while getopts ":d:i:x:ych" opt; do
    case "$opt" in
      d) fragment_dirs+=("$OPTARG") ;;
      i) include_patterns+=("$OPTARG") ;;
      x) exclude_patterns+=("$OPTARG") ;;
      y) yaml_mode=1 ;;
      c) mode=check ;;
      h) _claude_mergerc_usage; return 0 ;;
      :) echo "error: -$OPTARG requires an argument" >&2; return 1 ;;
      \?) echo "error: unknown option -$OPTARG" >&2; return 1 ;;
    esac
  done
  shift $((OPTIND - 1))

  (( ${#include_patterns[@]} == 0 )) && include_patterns=('*.json' '*.yaml' '*.yml')

  if ! command -v jq &>/dev/null; then
    echo "error: jq is required but not found in PATH" >&2
    return 1
  fi

  if [[ -L "$output" ]]; then
    local link_target
    link_target=$(readlink "$output")
    if [[ ! -e "$output" ]]; then
      echo "error: $output is a broken symlink → $link_target" >&2
      echo "       remove or fix the symlink before merging" >&2
      return 1
    elif [[ ! -f "$output" ]]; then
      echo "error: $output is a symlink to a non-regular file → $link_target" >&2
      return 1
    fi
  elif [[ -e "$output" && ! -f "$output" ]]; then
    local type_desc
    if [[ -d "$output" ]]; then type_desc="directory"
    elif [[ -p "$output" ]]; then type_desc="named pipe"
    elif [[ -S "$output" ]]; then type_desc="socket"
    else type_desc="non-regular file"
    fi
    echo "error: $output exists but is not a regular file ($type_desc)" >&2
    return 1
  fi

  local -a fragment_files dir_files
  local dir f
  for dir in "${fragment_dirs[@]}"; do
    if [[ ! -d "$dir" ]]; then
      echo "warning: skipping missing fragments dir: $dir" >&2
      continue
    fi
    dir_files=()
    for f in "$dir"/**/*(.N); do
      _claude_mergerc_matches "${f:t}" && dir_files+=("$f")
    done
    fragment_files+=("${(on)dir_files[@]}")
  done

  if (( ${#fragment_files[@]} == 0 )); then
    echo "error: no matching fragments found" >&2
    echo "       dirs:    ${(j/, /)fragment_dirs}" >&2
    echo "       include: ${(j/, /)include_patterns}" >&2
    (( ${#exclude_patterns[@]} )) && echo "       exclude: ${(j/, /)exclude_patterns}" >&2
    return 1
  fi

  local has_yaml=0
  for f in "${fragment_files[@]}"; do
    [[ "$f" == *.(yaml|yml) ]] && { has_yaml=1; break; }
  done
  if (( has_yaml || yaml_mode )); then
    _claude_mergerc_require_yq
  fi

  local workdir="${TMPDIR:-/tmp}/claude-mergerc.$$"
  mkdir -p "$workdir"
  # Expand $workdir now: function-scoped EXIT traps run after locals are gone.
  trap "rm -rf ${(q)workdir}" EXIT

  echo "Merging ${#fragment_files[@]} fragment(s) from ${#fragment_dirs[@]} dir(s)..."

  local merged_json="$workdir/from-fragments.json"
  _claude_mergerc_merge "$merged_json" "${fragment_files[@]}"

  if [[ "$mode" != apply ]]; then
    if [[ ! -e "$output" ]]; then
      echo "error: $output does not exist; nothing to check for drift" >&2
      return 1
    fi
    _claude_mergerc_drift
    return
  fi

  # In YAML mode, stage the merged config as YAML for diff/editor.
  # YAML is for human eyes only: every path that writes $output writes JSON,
  # since Claude Code only reads JSON settings.
  local merged_yaml="$workdir/from-fragments.yaml"
  if (( yaml_mode )); then
    yq -P 'sort_keys(..)' -o=yaml "$merged_json" > "$merged_yaml"
  fi

  if [[ ! -e "$output" ]]; then
    echo "No existing settings.json found. Will create new."
    echo ""
    if (( yaml_mode )); then
      cat "$merged_yaml"
    else
      jq '.' "$merged_json"
    fi
    echo ""
    read -q "reply?Create $output? [y/n] " || { echo "\nAborted."; return 0 }
    echo ""
    mkdir -p "$(dirname "$output")"
    cp "$merged_json" "$output"
    echo "Created $output"
    return 0
  fi

  local existing_normalized merged_normalized
  existing_normalized=$(jq -S '.' "$output")
  merged_normalized=$(jq -S '.' "$merged_json")

  if [[ "$existing_normalized" == "$merged_normalized" ]]; then
    echo "No changes. Settings are already in sync."
    return 0
  fi

  # Materialize both sides for diffing — YAML or sorted JSON.
  # "current" = what settings.json holds now; "from-fragments" = the merge result.
  local diff_current diff_merged
  if (( yaml_mode )); then
    diff_current="$workdir/diff/current.yaml"
    diff_merged="$workdir/diff/from-fragments.yaml"
    mkdir -p "$workdir/diff"
    yq -P 'sort_keys(..)' -o=yaml "$output" > "$diff_current"
    cp "$merged_yaml" "$diff_merged"
  else
    diff_current="$workdir/diff/current.json"
    diff_merged="$workdir/diff/from-fragments.json"
    mkdir -p "$workdir/diff"
    jq -S '.' "$output" > "$diff_current"
    jq -S '.' "$merged_json" > "$diff_merged"
  fi

  echo "Differences found:\n"

  _claude_mergerc_show_diff "$diff_current" "$diff_merged"

  echo ""
  echo "  [a] Apply merged config (overwrites current)"
  echo "  [b] Backup current, then apply"
  if (( yaml_mode )); then
    echo "  [e] Manual merge in \$EDITOR as YAML (edit 'to-apply', pull from 'from-fragments')"
  else
    echo "  [e] Manual merge in \$EDITOR (edit 'to-apply', pull from 'from-fragments')"
  fi
  echo "  [q] Quit, no changes"
  echo ""
  local choice
  read -k 1 "choice?Choose [a/b/e/q]: "
  echo ""

  case "$choice" in
    a)
      cp "$merged_json" "$output"
      echo "Applied merged config to $output"
      ;;
    b)
      local backup="${output}.bak.$(date +%Y%m%d%H%M%S)"
      cp "$output" "$backup"
      cp "$merged_json" "$output"
      echo "Backup → $backup"
      echo "Applied merged config to $output"
      ;;
    e)
      # Buffer names signal intent: "to-apply" is seeded from the current
      # settings, is the one you edit, and is what gets written to $output.
      # "from-fragments" is the merged result, opened as reference only.
      if (( yaml_mode )); then
        local apply_tmp="$workdir/to-apply.yaml" apply_json="$workdir/to-apply.json"
        cp "$diff_current" "$apply_tmp"
        ${EDITOR:-vim} -d "$apply_tmp" "$merged_yaml"
        if yq -o=json '.' "$apply_tmp" > "$apply_json" 2>/dev/null \
            && jq empty "$apply_json" 2>/dev/null; then
          read -q "reply?Apply manually merged result? [y/n] " || { echo "\nAborted."; return 0 }
          echo ""
          cp "$apply_json" "$output"
          echo "Applied manually merged config."
        else
          echo "error: result is not valid YAML. Aborting." >&2
          return 1
        fi
      else
        local apply_tmp="$workdir/to-apply.json"
        cp "$output" "$apply_tmp"
        ${EDITOR:-vim} -d "$apply_tmp" "$merged_json"
        if jq empty "$apply_tmp" 2>/dev/null; then
          read -q "reply?Apply manually merged result? [y/n] " || { echo "\nAborted."; return 0 }
          echo ""
          cp "$apply_tmp" "$output"
          echo "Applied manually merged config."
        else
          echo "error: result is not valid JSON. Aborting." >&2
          return 1
        fi
      fi
      ;;
    q|*)
      echo "No changes made."
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Drift: places where settings.json no longer matches the merged fragments,
# usually because Claude Code wrote to settings.json itself (e.g. "always
# allow" on a permission prompt).
#
# The helpers below share state through zsh's dynamic scoping. They read the
# locals of claude-mergerc (output, workdir, merged_json) and of
# _claude_mergerc_drift (jqlib).
# ---------------------------------------------------------------------------

# Print a one-line summary per item in file $1.
function _claude_mergerc_drift_list() {
  jq -r "$jqlib"'
    def short: tojson | if length > 60 then .[:57] + "..." else . end;
    (.path | pathstr) as $ps
    | if .kind == "changed" then "  ~ \($ps): \(.merged | short) → \(.current | short)"
      elif .kind == "added" then "  + \($ps): \(.current | short)"
      elif .kind == "removed" then "  - \($ps): \(.merged | short)"
      elif .kind == "array-add" then "  + \($ps)[]: \(.value | short)"
      else "  - \($ps)[]: \(.value | short)"
      end' "$1"
  echo ""
  echo "  (+ only in settings.json   - only in fragments   ~ fragments → settings.json)"
}

function _claude_mergerc_drift() {
  local jqlib
  jqlib=$(_claude_mergerc_jqlib)

  local items_file="$workdir/drift.jsonl"
  jq -c -n --slurpfile c "$output" --slurpfile m "$merged_json" \
    "$jqlib drift_items(\$c[0]; \$m[0]; [])" > "$items_file"
  local -a items
  items=(${(f)"$(<"$items_file")"})

  if (( ${#items} == 0 )); then
    echo "No drift: settings.json matches the fragments."
    return 0
  fi

  echo "Drift: ${#items} item(s) where settings.json differs from the fragments:"
  echo ""
  _claude_mergerc_drift_list "$items_file"

  return 1
}

# On first invocation, zsh's native autoload executes this file's body — which
# only *defines* the functions above — without running the command. Call it
# explicitly so the first invocation behaves like every other one.
claude-mergerc "$@"
