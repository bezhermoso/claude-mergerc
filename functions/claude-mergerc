#!/usr/bin/env zsh
# claude-mergerc
# Merge Claude Code settings fragments with interactive diff/apply.
# https://github.com/bezhermoso/claude-mergerc

function _claude_mergerc_usage() {
  cat <<'EOF'
Usage: claude-mergerc [-d DIR]... [-i GLOB]... [-x GLOB]... [-y] [-c | -D] [-h]

Merge Claude Code settings fragments into ~/.claude/settings.json.

Modes:
  (default) Show a diff of settings.json vs the merged fragments, then apply.
  -c        Check for drift: list every place settings.json differs from the
            merged fragments. Changes nothing. Exits 1 if there is drift.
  -D        Resolve drift interactively, one item at a time:
              adopt  - keep the settings.json value and write it into a fragment
              revert - restore the value the fragments resolve to
              ignore - leave it as is
              skip   - decide later (offered again at the end)
              undo   - go back and redo the previous decision
            All changes are staged; nothing is written until you confirm.

Options:
  -d DIR    Fragments directory (repeatable). Extends CLAUDE_MERGERC_FRAGMENTS_DIR.
  -i GLOB   Include pattern — filename glob (repeatable). Extends CLAUDE_MERGERC_INCLUDE.
            Default: *.json, *.yaml, *.yml
  -x GLOB   Exclude pattern — filename glob (repeatable). Extends CLAUDE_MERGERC_EXCLUDE.
  -y        YAML mode: stage the merged config as YAML, show the diff in YAML,
            and open YAML buffers for manual merge. Output is still JSON.
  -h        Show this help.

Environment (colon-separated lists):
  CLAUDE_MERGERC_FRAGMENTS_DIR  Dirs. Default: ${XDG_CONFIG_HOME:-~/.config}/claude/fragments
  CLAUDE_MERGERC_INCLUDE        Include globs. Default: *.json:*.yaml:*.yml
  CLAUDE_MERGERC_EXCLUDE        Exclude globs.
  CLAUDE_MERGERC_OUTPUT         Output file. Default: ~/.claude/settings.json
  CLAUDE_MERGERC_YAML           Set to 1 to enable YAML mode (same as -y).
  CLAUDE_MERGERC_COLOR          auto (default), always, or never. auto colours
                                output on a colour terminal unless NO_COLOR is set.

YAML fragments and YAML mode require yq (https://github.com/mikefarah/yq).

Dirs are processed in order; within each dir, files are sorted by basename.
Later files override earlier ones for deep-merged values.

If the output path is a symlink to a regular file, the link is followed and
its target is overwritten (standard dotfile-manager behavior). Symlinks to
directories, broken symlinks, and non-regular files are rejected.
EOF
}

function _claude_mergerc_require_yq() {
  if ! command -v yq &>/dev/null; then
    _claude_mergerc_err "yq is required for YAML support but not found in PATH"
    echo "       install: https://github.com/mikefarah/yq" >&2
    return 1
  fi
  if ! yq --version 2>/dev/null | grep -q mikefarah; then
    _claude_mergerc_err "incompatible yq found; mikefarah/yq v4+ is required for YAML support"
    echo "       install: https://github.com/mikefarah/yq" >&2
    return 1
  fi
}

# Shared jq definitions: the merge itself, plus the drift model.
function _claude_mergerc_jqlib() {
  cat <<'EOF'
def deep_merge(a; b):
  a as $a | b as $b |
  if ($a | type) == "object" and ($b | type) == "object" then
    ($a | keys) + ($b | keys) | unique | map(
      . as $k |
      if ($a | has($k)) and ($b | has($k)) then
        {($k): deep_merge($a[$k]; $b[$k])}
      elif ($b | has($k)) then {($k): $b[$k]}
      else {($k): $a[$k]}
      end
    ) | add // {}
  elif ($a | type) == "array" and ($b | type) == "array" then
    $a + $b | unique
  else $b
  end;

# Arrays merge as sets, so compare them as sets.
def canon: walk(if type == "array" then unique else . end);

def pathstr:
  if length == 0 then "."
  else map(
    if type == "string" and test("^[A-Za-z_][A-Za-z0-9_]*$") then "." + .
    else "[" + tojson + "]"
    end) | join("")
  end;

def haspath($p):
  if ($p | length) == 0 then true
  else try (getpath($p[:-1]) | type == "object" and has($p[-1])) catch false
  end;

def arrayat($p): try (getpath($p) | if type == "array" then . else null end) catch null;

# One item per leaf where $c (settings.json) differs from $m (merged
# fragments). Arrays are treated as sets: each element present on only one
# side is its own item.
def drift_items($c; $m; $p):
  if ($c | type) == "object" and ($m | type) == "object" then
    (($c | keys) + ($m | keys) | unique)[] as $k
    | if ($c | has($k)) and ($m | has($k)) then drift_items($c[$k]; $m[$k]; $p + [$k])
      elif ($c | has($k)) then {kind: "added", path: ($p + [$k]), current: $c[$k]}
      else {kind: "removed", path: ($p + [$k]), merged: $m[$k]}
      end
  elif ($c | type) == "array" and ($m | type) == "array" then
    (($c | unique)[] as $e | select(any($m[]; . == $e) | not)
      | {kind: "array-add", path: $p, value: $e}),
    (($m | unique)[] as $e | select(any($c[]; . == $e) | not)
      | {kind: "array-remove", path: $p, value: $e})
  elif $c == $m then empty
  else {kind: "changed", path: $p, current: $c, merged: $m}
  end;

# Given a merged config as input, is item $i no longer drifting if
# settings.json keeps its current value?
def resolved($i):
  if $i.kind == "changed" or $i.kind == "added" then
    haspath($i.path) and ((getpath($i.path) | canon) == ($i.current | canon))
  elif $i.kind == "removed" then haspath($i.path) | not
  elif $i.kind == "array-add" then (arrayat($i.path) // []) | any(.[]; . == $i.value)
  else (arrayat($i.path) // []) | any(.[]; . == $i.value) | not
  end;
EOF
}

# Print a fragment as JSON. An empty YAML file reads as {} rather than null.
function _claude_mergerc_to_json() {
  if [[ "$1" == *.(yaml|yml) ]]; then
    yq -o=json '. // {}' "$1"
  else
    jq '.' "$1"
  fi
}

# _claude_mergerc_merge OUT FILE... — deep-merge fragments (in order) into OUT.
function _claude_mergerc_merge() {
  local out="$1"; shift
  local -a inputs
  local f n=0 converted
  for f in "$@"; do
    if [[ "$f" == *.(yaml|yml) ]]; then
      converted="${out:h}/.yaml-to-json-$((++n)).json"
      if ! _claude_mergerc_to_json "$f" > "$converted"; then
        _claude_mergerc_err "failed to parse YAML fragment: $f"
        return 1
      fi
      inputs+=("$converted")
    else
      inputs+=("$f")
    fi
  done
  jq -s "$(_claude_mergerc_jqlib)"' reduce .[] as $item ({}; deep_merge(.; $item))' \
    "${inputs[@]}" > "$out"
}

# Set the c_* colour codes in the caller's scope; all empty when colour is off.
# CLAUDE_MERGERC_COLOR=auto (default) colours only when stdout is a terminal
# that supports at least 8 colours and NO_COLOR is unset; always/never force it.
function _claude_mergerc_init_colors() {
  c_reset="" c_bold="" c_dim="" c_red="" c_green="" c_yellow="" c_cyan=""
  local ncolors
  case "${CLAUDE_MERGERC_COLOR:-auto}" in
    never|0|false|no) return 0 ;;
    always|1|true|yes) ;;
    *)
      if [[ -n "${NO_COLOR:-}" || ! -t 1 ]]; then return 0; fi
      ncolors=$(tput colors 2>/dev/null) || ncolors=0
      if [[ "$ncolors" != <-> ]] || (( ncolors < 8 )); then return 0; fi
      ;;
  esac
  c_reset=$'\e[0m' c_bold=$'\e[1m' c_dim=$'\e[2m'
  c_red=$'\e[31m' c_green=$'\e[32m' c_yellow=$'\e[33m' c_cyan=$'\e[36m'
}

# Messages on stderr: coloured only if stderr is a terminal too.
function _claude_mergerc_err() {
  local on="" off=""
  if [[ -n "$c_reset" && ( -t 2 || "${CLAUDE_MERGERC_COLOR:-}" == (always|1|true|yes) ) ]]; then
    on="$c_red" off="$c_reset"
  fi
  print -r -- "${on}error:${off} $*" >&2
}

function _claude_mergerc_warn() {
  local on="" off=""
  if [[ -n "$c_reset" && ( -t 2 || "${CLAUDE_MERGERC_COLOR:-}" == (always|1|true|yes) ) ]]; then
    on="$c_yellow" off="$c_reset"
  fi
  print -r -- "${on}warning:${off} $*" >&2
}

# A highlighted menu key, e.g. "[a]".
function _claude_mergerc_key() {
  print -rn -- "[${c_bold}${c_cyan}$1${c_reset}]"
}

# _claude_mergerc_ask_key VAR PROMPT KEYS — read single keypresses until one of
# KEYS (case-insensitive) is pressed; anything else asks again instead of
# being taken as a choice. Returns 1 only if input ends (e.g. Ctrl-D).
function _claude_mergerc_ask_key() {
  local __var="$1" __prompt="$2" __keys="$3" __k
  while true; do
    if ! read -k 1 "__k?$__prompt"; then echo ""; return 1; fi
    if [[ "$__k" != $'\n' ]]; then echo ""; fi
    __k="${__k:l}"
    if [[ "$__k" != [[:space:]] && "$__keys" == *"$__k"* ]]; then
      : ${(P)__var::=$__k}
      return 0
    fi
    print -r -- "  ${c_yellow}Please press ${(j:, :)${(s::)__keys}}.${c_reset}"
  done
}

# _claude_mergerc_ask_yn PROMPT — 0 for y, 1 for n (or end of input).
function _claude_mergerc_ask_yn() {
  local __yn
  _claude_mergerc_ask_key __yn "$1" yn || return 1
  [[ "$__yn" == y ]]
}

# _claude_mergerc_ask_line VAR PROMPT — read a line. Returns 1 if input ends.
function _claude_mergerc_ask_line() {
  local __var="$1" __line
  if ! read -r "__line?$2"; then echo ""; return 1; fi
  : ${(P)__var::=$__line}
}

# Colour a unified diff on stdin: additions green, removals red.
function _claude_mergerc_colorize_diff() {
  if [[ -z "$c_reset" ]]; then cat; return; fi
  awk -v r="$c_red" -v g="$c_green" -v c="$c_cyan" -v b="$c_bold" -v z="$c_reset" '
    /^(\+\+\+|---) / { print b $0 z; next }
    /^@@/            { print c $0 z; next }
    /^\+/            { print g $0 z; next }
    /^-/             { print r $0 z; next }
                     { print }'
}

# _claude_mergerc_diff BEFORE AFTER LABEL_BEFORE LABEL_AFTER — unified diff.
# With colour on, it goes through delta or colordiff when installed, else our
# own colouring; with colour off, it's plain.
function _claude_mergerc_diff() {
  local -a args
  args=(-u --label "$3" --label "$4" "$1" "$2")
  if [[ -z "$c_reset" ]]; then
    diff "${args[@]}" || true
  elif command -v delta &>/dev/null; then
    diff "${args[@]}" | delta --pager=never || true
  elif command -v colordiff &>/dev/null; then
    diff "${args[@]}" | colordiff || true
  else
    diff "${args[@]}" | _claude_mergerc_colorize_diff || true
  fi
}

# Print a JSON or YAML config file, syntax-coloured when colour is on.
function _claude_mergerc_print_config() {
  local -a color
  if [[ -n "$c_reset" ]]; then color=(-C); fi
  if [[ "$1" == *.(yaml|yml) ]]; then
    yq "${color[@]}" '.' "$1"
  else
    jq "${color[@]}" '.' "$1"
  fi
}

# Does a fragment basename match the include/exclude patterns in scope?
function _claude_mergerc_matches() {
  local fname="$1" pat
  local included=0
  for pat in "${include_patterns[@]}"; do
    if [[ "$fname" == ${~pat} ]]; then included=1; break; fi
  done
  (( included )) || return 1
  for pat in "${exclude_patterns[@]}"; do
    if [[ "$fname" == ${~pat} ]]; then return 1; fi
  done
  return 0
}

function claude-mergerc() {
  emulate -L zsh
  setopt local_options err_return no_unset pipe_fail

  local c_reset c_bold c_dim c_red c_green c_yellow c_cyan
  _claude_mergerc_init_colors

  local output="${CLAUDE_MERGERC_OUTPUT:-$HOME/.claude/settings.json}"
  local yaml_mode=0 mode=apply
  [[ "${CLAUDE_MERGERC_YAML:-}" == (1|true|yes) ]] && yaml_mode=1

  local -a fragment_dirs include_patterns exclude_patterns
  if [[ -n "${CLAUDE_MERGERC_FRAGMENTS_DIR:-}" ]]; then
    fragment_dirs=("${(@s/:/)CLAUDE_MERGERC_FRAGMENTS_DIR}")
  else
    fragment_dirs=("${XDG_CONFIG_HOME:-$HOME/.config}/claude/fragments")
  fi
  [[ -n "${CLAUDE_MERGERC_INCLUDE:-}" ]] && include_patterns=("${(@s/:/)CLAUDE_MERGERC_INCLUDE}")
  [[ -n "${CLAUDE_MERGERC_EXCLUDE:-}" ]] && exclude_patterns=("${(@s/:/)CLAUDE_MERGERC_EXCLUDE}")

  local OPTARG OPTIND opt
  OPTIND=1
  while getopts ":d:i:x:ycDh" opt; do
    case "$opt" in
      d) fragment_dirs+=("$OPTARG") ;;
      i) include_patterns+=("$OPTARG") ;;
      x) exclude_patterns+=("$OPTARG") ;;
      y) yaml_mode=1 ;;
      c) mode=check ;;
      D) mode=drift ;;
      h) _claude_mergerc_usage; return 0 ;;
      :) _claude_mergerc_err "-$OPTARG requires an argument"; return 1 ;;
      \?) _claude_mergerc_err "unknown option -$OPTARG"; return 1 ;;
    esac
  done
  shift $((OPTIND - 1))

  (( ${#include_patterns[@]} == 0 )) && include_patterns=('*.json' '*.yaml' '*.yml')

  if ! command -v jq &>/dev/null; then
    _claude_mergerc_err "jq is required but not found in PATH"
    return 1
  fi

  if [[ -L "$output" ]]; then
    local link_target
    link_target=$(readlink "$output")
    if [[ ! -e "$output" ]]; then
      _claude_mergerc_err "$output is a broken symlink → $link_target"
      echo "       remove or fix the symlink before merging" >&2
      return 1
    elif [[ ! -f "$output" ]]; then
      _claude_mergerc_err "$output is a symlink to a non-regular file → $link_target"
      return 1
    fi
  elif [[ -e "$output" && ! -f "$output" ]]; then
    local type_desc
    if [[ -d "$output" ]]; then type_desc="directory"
    elif [[ -p "$output" ]]; then type_desc="named pipe"
    elif [[ -S "$output" ]]; then type_desc="socket"
    else type_desc="non-regular file"
    fi
    _claude_mergerc_err "$output exists but is not a regular file ($type_desc)"
    return 1
  fi

  local -a fragment_files dir_files
  local dir f
  for dir in "${fragment_dirs[@]}"; do
    if [[ ! -d "$dir" ]]; then
      _claude_mergerc_warn "skipping missing fragments dir: $dir"
      continue
    fi
    dir_files=()
    for f in "$dir"/**/*(.N); do
      _claude_mergerc_matches "${f:t}" && dir_files+=("$f")
    done
    fragment_files+=("${(on)dir_files[@]}")
  done

  if (( ${#fragment_files[@]} == 0 )); then
    _claude_mergerc_err "no matching fragments found"
    echo "       dirs:    ${(j/, /)fragment_dirs}" >&2
    echo "       include: ${(j/, /)include_patterns}" >&2
    (( ${#exclude_patterns[@]} )) && echo "       exclude: ${(j/, /)exclude_patterns}" >&2
    return 1
  fi

  local has_yaml=0
  for f in "${fragment_files[@]}"; do
    [[ "$f" == *.(yaml|yml) ]] && { has_yaml=1; break; }
  done
  if (( has_yaml || yaml_mode )); then
    _claude_mergerc_require_yq
  fi

  local workdir="${TMPDIR:-/tmp}/claude-mergerc.$$"
  mkdir -p "$workdir"
  # Expand $workdir now: function-scoped EXIT traps run after locals are gone.
  trap "rm -rf ${(q)workdir}" EXIT

  echo "${c_dim}Merging ${#fragment_files[@]} fragment(s) from ${#fragment_dirs[@]} dir(s)...${c_reset}"

  local merged_json="$workdir/from-fragments.json"
  _claude_mergerc_merge "$merged_json" "${fragment_files[@]}"

  if [[ "$mode" != apply ]]; then
    if [[ ! -e "$output" ]]; then
      _claude_mergerc_err "$output does not exist; nothing to check for drift"
      return 1
    fi
    _claude_mergerc_drift "$mode"
    return
  fi

  # In YAML mode, stage the merged config as YAML for diff/editor.
  # YAML is for human eyes only: every path that writes $output writes JSON,
  # since Claude Code only reads JSON settings.
  local merged_yaml="$workdir/from-fragments.yaml"
  if (( yaml_mode )); then
    yq -P 'sort_keys(..)' -o=yaml "$merged_json" > "$merged_yaml"
  fi

  if [[ ! -e "$output" ]]; then
    echo "No existing settings.json found. Will create new."
    echo ""
    if (( yaml_mode )); then
      _claude_mergerc_print_config "$merged_yaml"
    else
      _claude_mergerc_print_config "$merged_json"
    fi
    echo ""
    if ! _claude_mergerc_ask_yn "Create $output? [y/n] "; then
      echo "Aborted."
      return 0
    fi
    mkdir -p "$(dirname "$output")"
    cp "$merged_json" "$output"
    echo "${c_green}Created${c_reset} $output"
    return 0
  fi

  local existing_normalized merged_normalized
  existing_normalized=$(jq -S '.' "$output")
  merged_normalized=$(jq -S '.' "$merged_json")

  if [[ "$existing_normalized" == "$merged_normalized" ]]; then
    echo "${c_green}No changes.${c_reset} Settings are already in sync."
    return 0
  fi

  # Materialize both sides for diffing — YAML or sorted JSON.
  # "current" = what settings.json holds now; "from-fragments" = the merge result.
  local diff_current diff_merged
  if (( yaml_mode )); then
    diff_current="$workdir/diff/current.yaml"
    diff_merged="$workdir/diff/from-fragments.yaml"
    mkdir -p "$workdir/diff"
    yq -P 'sort_keys(..)' -o=yaml "$output" > "$diff_current"
    cp "$merged_yaml" "$diff_merged"
  else
    diff_current="$workdir/diff/current.json"
    diff_merged="$workdir/diff/from-fragments.json"
    mkdir -p "$workdir/diff"
    jq -S '.' "$output" > "$diff_current"
    jq -S '.' "$merged_json" > "$diff_merged"
  fi

  echo "${c_bold}Differences found:${c_reset}\n"

  _claude_mergerc_diff "$diff_current" "$diff_merged" "settings.json (current)" "from fragments"

  local format=JSON
  if (( yaml_mode )); then format=YAML; fi
  echo ""
  echo "  $(_claude_mergerc_key a) Apply merged config (overwrites current)"
  echo "  $(_claude_mergerc_key b) Backup current, then apply"
  if (( yaml_mode )); then
    echo "  $(_claude_mergerc_key e) Manual merge in \$EDITOR as YAML (edit 'to-apply', pull from 'from-fragments')"
  else
    echo "  $(_claude_mergerc_key e) Manual merge in \$EDITOR (edit 'to-apply', pull from 'from-fragments')"
  fi
  echo "  $(_claude_mergerc_key q) Quit, no changes"
  echo ""
  local choice
  if ! _claude_mergerc_ask_key choice "Choose [a/b/e/q]: " abeq; then
    echo "No changes made."
    return 0
  fi

  case "$choice" in
    a)
      cp "$merged_json" "$output"
      echo "${c_green}Applied${c_reset} merged config to $output"
      ;;
    b)
      local backup="${output}.bak.$(date +%Y%m%d%H%M%S)"
      cp "$output" "$backup"
      cp "$merged_json" "$output"
      echo "${c_dim}Backup → $backup${c_reset}"
      echo "${c_green}Applied${c_reset} merged config to $output"
      ;;
    e)
      # Buffer names signal intent: "to-apply" is seeded from the current
      # settings, is the one you edit, and is what gets written to $output.
      # "from-fragments" is the merged result, opened as reference only.
      local apply_tmp apply_json reference again valid
      if (( yaml_mode )); then
        apply_tmp="$workdir/to-apply.yaml" apply_json="$workdir/to-apply.json"
        reference="$merged_yaml"
        cp "$diff_current" "$apply_tmp"
      else
        apply_tmp="$workdir/to-apply.json" apply_json="$workdir/to-apply.json"
        reference="$merged_json"
        cp "$output" "$apply_tmp"
      fi
      while true; do
        ${EDITOR:-vim} -d "$apply_tmp" "$reference"
        valid=0
        if (( yaml_mode )); then
          if yq -o=json '.' "$apply_tmp" > "$apply_json" 2>/dev/null \
              && jq empty "$apply_json" 2>/dev/null; then
            valid=1
          fi
        elif jq empty "$apply_tmp" 2>/dev/null; then
          valid=1
        fi
        if (( valid )); then break; fi
        # Your edits are kept: editing again reopens them.
        _claude_mergerc_err "the result is not valid $format."
        if ! _claude_mergerc_ask_key again \
            "  $(_claude_mergerc_key e) Edit again  $(_claude_mergerc_key q) Quit, no changes: " eq; then
          again=q
        fi
        if [[ "$again" == q ]]; then
          echo "No changes made."
          return 1
        fi
      done
      if ! _claude_mergerc_ask_yn "Apply manually merged result? [y/n] "; then
        echo "Aborted."
        return 0
      fi
      cp "$apply_json" "$output"
      echo "${c_green}Applied${c_reset} manually merged config."
      ;;
    q)
      echo "No changes made."
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Drift: places where settings.json no longer matches the merged fragments,
# usually because Claude Code wrote to settings.json itself (e.g. "always
# allow" on a permission prompt).
#
# The helpers below share state through zsh's dynamic scoping. They read the
# locals of claude-mergerc (output, workdir, merged_json, fragment_dirs,
# fragment_files, include/exclude patterns, yaml_mode) and of
# _claude_mergerc_drift (jqlib and the staging area).
#
# Nothing live is touched until the final confirmation: every decision edits
# copies under $workdir/stage.
# ---------------------------------------------------------------------------

function _claude_mergerc_tilde() {
  print -r -- "${1/#${HOME}/~}"
}

# Format a JSON value for display: inline if short, else an indented block.
function _claude_mergerc_drift_fmt() {
  local compact
  compact=$(jq -c '.' <<< "$1")
  if (( ${#compact} <= 72 )); then
    print -r -- "$compact"
    return 0
  fi
  echo ""
  if (( yaml_mode )); then
    yq -p=json -o=yaml -P '.' <<< "$1" | sed 's/^/        /'
  else
    jq '.' <<< "$1" | sed 's/^/        /'
  fi
}

# Set reply to the fragment list in merge order (live paths), including new
# files staged during this session.
function _claude_mergerc_drift_fragments() {
  local -a all in_dir
  all=("${fragment_files[@]}" "${new_files[@]}")
  local dir f
  reply=()
  for dir in "${fragment_dirs[@]}"; do
    in_dir=()
    for f in "${all[@]}"; do
      if [[ "$f" == "$dir"/* ]]; then in_dir+=("$f"); fi
    done
    reply+=("${(on)in_dir[@]}")
  done
}

# Merge the fragments as staged into $1.
function _claude_mergerc_drift_merge() {
  local -a srcs
  local f
  _claude_mergerc_drift_fragments
  for f in "${reply[@]}"; do srcs+=("${staged[$f]:-$f}"); done
  _claude_mergerc_merge "$1" "${srcs[@]}"
}

# _claude_mergerc_drift_select PRED PATH [VALUE] — set reply to the fragments
# (as staged) for which the jq predicate PRED is true, with $p and $v bound.
function _claude_mergerc_drift_select() {
  local pred="$1" p="$2" v="${3:-null}" f
  local -a frags
  _claude_mergerc_drift_fragments
  frags=("${reply[@]}")
  reply=()
  for f in "${frags[@]}"; do
    if [[ "$(_claude_mergerc_to_json "${staged[$f]:-$f}" \
        | jq --argjson p "$p" --argjson v "$v" "$jqlib $pred")" == true ]]; then
      reply+=("$f")
    fi
  done
}

# Set reply to the fragments an additive adoption could go into, best last.
function _claude_mergerc_drift_candidates() {
  local kind="$1" p="$2" len L
  if [[ "$kind" == changed ]]; then
    # Only the last fragment defining the key wins the merge.
    _claude_mergerc_drift_select 'haspath($p)' "$p"
    if (( ${#reply} )); then reply=("${reply[-1]}"); fi
    return 0
  fi
  if [[ "$kind" == array-add ]]; then
    # Arrays concatenate, so any fragment that defines the list works.
    _claude_mergerc_drift_select 'arrayat($p) != null' "$p"
    if (( ${#reply} )); then return 0; fi
  fi
  # A new key: offer the fragments that hold its nearest existing parent.
  len=$(jq 'length' <<< "$p")
  L=$((len - 1))
  while (( L >= 0 )); do
    _claude_mergerc_drift_select \
      "(\$p | .[:$L]) as \$q | try (getpath(\$q) | type == \"object\") catch false" "$p"
    if (( ${#reply} )); then return 0; fi
    L=$((L - 1))
  done
  return 0
}

# Copy a fragment into the staging area (once). Sets REPLY to the copy.
function _claude_mergerc_drift_stage() {
  local f="$1" s
  if [[ -z "${staged[$f]:-}" ]]; then
    stage_n=$((stage_n + 1))
    s="$stage_dir/fragment-$stage_n.${f:e}"
    if [[ -e "$f" ]]; then
      cp "$f" "$s" || return 1
      cp "$f" "$workdir/orig/fragment-$stage_n.${f:e}" || return 1
      origs[$f]="$workdir/orig/fragment-$stage_n.${f:e}"
    elif [[ "$f" == *.(yaml|yml) ]]; then
      : > "$s"
    else
      echo '{}' > "$s"
    fi
    staged[$f]="$s"
  fi
  REPLY="${staged[$f]}"
}

# _claude_mergerc_drift_edit FRAGMENT OP PATH [VALUE] — edit the staged copy.
# OP: set | append (to a list) | delete | remove-elem (from a list).
# YAML fragments are edited with yq in place, so comments survive.
function _claude_mergerc_drift_edit() {
  local f="$1" op="$2" p="$3" v="${4:-null}" s idx
  _claude_mergerc_drift_stage "$f" || return 1
  s="$REPLY"
  if [[ "$s" == *.(yaml|yml) ]]; then
    # Values arrive as JSON; drop its flow style so they read as block YAML.
    local block='(.. | select(tag == "!!map" or tag == "!!seq")) style=""'
    case "$op" in
      set)
        P="$p" V="$v" yq -i "setpath(env(P); env(V) | $block)" "$s" || return 1 ;;
      append)
        E="$(jq -r '"." + (map("[" + tojson + "]") | join(""))' <<< "$p")" V="$v" \
          yq -i "eval(strenv(E)) += [env(V) | $block]" "$s" || return 1 ;;
      delete)
        P="$p" yq -i 'delpaths([env(P)])' "$s" || return 1 ;;
      remove-elem)
        for idx in ${(f)"$(_claude_mergerc_to_json "$s" | jq --argjson p "$p" --argjson v "$v" \
            '[getpath($p) | to_entries[] | select(.value == $v) | .key] | reverse | .[]')"}; do
          P="$(jq -c --argjson i "$idx" '. + [$i]' <<< "$p")" yq -i 'delpaths([env(P)])' "$s" \
            || return 1
        done ;;
    esac
  else
    local prog
    case "$op" in
      set)         prog='setpath($p; $v)' ;;
      append)      prog='setpath($p; ((try getpath($p) catch null) // []) + [$v])' ;;
      delete)      prog='delpaths([$p])' ;;
      remove-elem) prog='setpath($p; getpath($p) | map(select(. != $v)))' ;;
    esac
    jq --argjson p "$p" --argjson v "$v" "$prog" "$s" > "$s.tmp" || return 1
    mv "$s.tmp" "$s"
  fi
}

function _claude_mergerc_drift_snapshot() {
  rm -rf "$workdir/snapshot"
  cp -R "$stage_dir" "$workdir/snapshot"
  snap_staged=("${(@kv)staged}")
  snap_new=("${new_files[@]}")
}

function _claude_mergerc_drift_restore() {
  rm -rf "$stage_dir"
  mv "$workdir/snapshot" "$stage_dir"
  staged=("${(@kv)snap_staged}")
  new_files=("${snap_new[@]}")
}

# Does item $1 stop drifting once the staged fragments are merged?
function _claude_mergerc_drift_verify() {
  _claude_mergerc_drift_merge "$workdir/verify.json" || return 1
  [[ "$(jq --argjson i "$1" "$jqlib resolved(\$i)" "$workdir/verify.json")" == true ]]
}

# Prompt for a new fragment file until a usable one is given. Sets REPLY to
# its live path. Returns 1 to go back, 2 to skip this item for now.
function _claude_mergerc_drift_new_file() {
  local last_dir="${fragment_dirs[-1]}" ext=json input dir match f abs found
  if (( yaml_mode )); then ext=yaml; fi
  local def="$last_dir/99-adopted.$ext"
  while true; do
    if ! _claude_mergerc_ask_line input \
        "  New fragment file [$(_claude_mergerc_tilde "$def")] (c: go back, s: skip for now): "; then
      return 1
    fi
    case "$input" in
      c) return 1 ;;
      s) return 2 ;;
      "") input="$def" ;;
    esac
    input="${input/#\~/$HOME}"
    if [[ "$input" != */* ]]; then input="$last_dir/$input"; fi
    abs="${input:A}"
    match=""
    for dir in "${fragment_dirs[@]}"; do
      if [[ "$abs" == "${dir:A}"/* ]]; then
        match="$dir/${abs#${dir:A}/}"
        break
      fi
    done
    if [[ -z "$match" ]]; then
      echo "  ${c_red}✗${c_reset} It must be inside a fragments dir: ${(j/, /)fragment_dirs}"
      continue
    fi
    if ! _claude_mergerc_matches "${match:t}"; then
      echo "  ${c_red}✗${c_reset} ${match:t} doesn't match the include/exclude patterns, so it would never be merged"
      continue
    fi
    found=""
    _claude_mergerc_drift_fragments
    for f in "${reply[@]}"; do
      if [[ "${f:A}" == "$abs" ]]; then found="$f"; break; fi
    done
    if [[ -n "$found" ]]; then
      REPLY="$found"
      return 0
    fi
    if [[ -e "$abs" ]]; then
      echo "  ${c_red}✗${c_reset} $(_claude_mergerc_tilde "$abs") already exists but isn't a fragment"
      continue
    fi
    new_files+=("$match")
    REPLY="$match"
    return 0
  done
}

# Choose among the candidates in reply (or a new file). Sets REPLY.
# Returns 1 to go back, 2 to skip this item for now. Bad input asks again.
function _claude_mergerc_drift_choose() {
  local -a cands
  cands=("${reply[@]}")
  local i f sel def="${#cands}" note rc show=1
  if (( def == 0 )); then def=n; fi
  while true; do
    if (( show )); then
      echo "  Adopt into:"
      i=0
      for f in "${cands[@]}"; do
        i=$((i + 1))
        note=""
        if [[ "$i" == "$def" ]]; then note="  ${c_dim}(default)${c_reset}"; fi
        echo "    $(_claude_mergerc_key $i) $(_claude_mergerc_tilde "$f")$note"
      done
      echo "    $(_claude_mergerc_key n) a new fragment file"
      echo "    $(_claude_mergerc_key c) go back   $(_claude_mergerc_key s) skip this item for now"
      show=0
    fi
    if ! _claude_mergerc_ask_line sel "  Choose [$def]: "; then return 1; fi
    sel="${sel:l}"
    if [[ -z "$sel" ]]; then sel="$def"; fi
    case "$sel" in
      n)
        _claude_mergerc_drift_new_file && return 0 || rc=$?
        if (( rc == 2 )); then return 2; fi
        show=1
        continue
        ;;
      c) return 1 ;;
      s) return 2 ;;
      <->)
        if (( sel >= 1 && sel <= ${#cands} )); then
          REPLY="${cands[$sel]}"
          return 0
        fi
        ;;
    esac
    echo "  ${c_yellow}No option \"$sel\". Pick one of the options above.${c_reset}"
  done
}

# Write the settings.json value into the fragments. Returns 0 when adopted,
# 1 to go back to the item's prompt, 2 to skip the item; on 1 or 2 nothing is
# left staged.
function _claude_mergerc_drift_adopt() {
  local item="$1" kind p v op target f rc answer
  local -a targets
  kind=$(jq -r '.kind' <<< "$item")
  p=$(jq -c '.path' <<< "$item")
  case "$kind" in
    changed|added|array-add)
      if [[ "$kind" == array-add ]]; then
        v=$(jq -c '.value' <<< "$item"); op=append
      else
        v=$(jq -c '.current' <<< "$item"); op=set
      fi
      _claude_mergerc_drift_candidates "$kind" "$p"
      _claude_mergerc_drift_snapshot
      _claude_mergerc_drift_choose && rc=0 || rc=$?
      if (( rc )); then
        _claude_mergerc_drift_restore
        return $rc
      fi
      target="$REPLY"
      if ! _claude_mergerc_drift_edit "$target" "$op" "$p" "$v" \
          || ! _claude_mergerc_drift_verify "$item"; then
        _claude_mergerc_drift_restore
        echo "  ${c_red}✗${c_reset} Adding it to $(_claude_mergerc_tilde "$target") wouldn't take effect (a later fragment overrides it). Pick another file."
        return 1
      fi
      REPLY="adopted into $(_claude_mergerc_tilde "$target")"
      ;;
    removed|array-remove)
      # The fragments must stop providing it, so it comes out of every
      # fragment that has it. A new file can't remove anything.
      if [[ "$kind" == removed ]]; then
        v=null
        _claude_mergerc_drift_select 'haspath($p)' "$p"
      else
        v=$(jq -c '.value' <<< "$item")
        _claude_mergerc_drift_select '(arrayat($p) // []) | any(.[]; . == $v)' "$p" "$v"
      fi
      targets=("${reply[@]}")
      echo "  Adopting removes it from:"
      for f in "${targets[@]}"; do echo "    $(_claude_mergerc_tilde "$f")"; done
      if ! _claude_mergerc_ask_key answer \
          "  Proceed? $(_claude_mergerc_key y) yes  $(_claude_mergerc_key n) go back  $(_claude_mergerc_key s) skip for now: " yns; then
        return 1
      fi
      case "$answer" in
        n) return 1 ;;
        s) return 2 ;;
      esac
      if [[ "$kind" == removed ]]; then op=delete; else op=remove-elem; fi
      _claude_mergerc_drift_snapshot
      for f in "${targets[@]}"; do
        if ! _claude_mergerc_drift_edit "$f" "$op" "$p" "$v"; then
          _claude_mergerc_drift_restore
          echo "  ${c_red}✗${c_reset} Couldn't edit $(_claude_mergerc_tilde "$f")"
          return 1
        fi
      done
      if ! _claude_mergerc_drift_verify "$item"; then
        _claude_mergerc_drift_restore
        echo "  ${c_red}✗${c_reset} The fragments would still provide it after removal; leaving it alone."
        return 1
      fi
      REPLY="adopted (removed from ${#targets} fragment(s))"
      ;;
  esac
}

# Put the value the fragments resolve to back into the staged settings.json.
function _claude_mergerc_drift_revert() {
  jq --argjson i "$1" '
    if $i.kind == "changed" or $i.kind == "removed" then setpath($i.path; $i.merged)
    elif $i.kind == "added" then delpaths([$i.path])
    elif $i.kind == "array-add" then setpath($i.path; getpath($i.path) | map(select(. != $i.value)))
    else setpath($i.path; getpath($i.path) + [$i.value])
    end' "$stage_settings" > "$stage_settings.tmp" || return 1
  mv "$stage_settings.tmp" "$stage_settings"
}

function _claude_mergerc_drift_show() {
  local n="$1" total="$2" item="$3" kind p ps label src
  kind=$(jq -r '.kind' <<< "$item")
  p=$(jq -c '.path' <<< "$item")
  ps=$(jq -r "$jqlib .path | pathstr" <<< "$item")
  case "$kind" in
    changed)      label="value changed" ;;
    added)        label="only in settings.json" ;;
    removed)      label="missing from settings.json" ;;
    array-add)    label="list entry only in settings.json" ;;
    array-remove) label="list entry missing from settings.json" ;;
  esac
  echo "${c_bold}[$n/$total] $ps${c_reset} ${c_dim}— $label${c_reset}"
  case "$kind" in
    changed)
      _claude_mergerc_drift_select 'haspath($p)' "$p"
      src=""
      if (( ${#reply} )); then src="  (from ${reply[-1]:t})"; fi
      echo "    ${c_green}settings.json: $(_claude_mergerc_drift_fmt "$(jq -c '.current' <<< "$item")")${c_reset}"
      echo "    ${c_red}fragments:     $(_claude_mergerc_drift_fmt "$(jq -c '.merged' <<< "$item")")${c_reset}${c_dim}$src${c_reset}"
      ;;
    added)
      echo "    ${c_green}settings.json: $(_claude_mergerc_drift_fmt "$(jq -c '.current' <<< "$item")")${c_reset}"
      ;;
    removed)
      _claude_mergerc_drift_select 'haspath($p)' "$p"
      echo "    ${c_red}fragments:     $(_claude_mergerc_drift_fmt "$(jq -c '.merged' <<< "$item")")${c_reset}  ${c_dim}(from ${(j/, /)${reply[@]:t}})${c_reset}"
      ;;
    array-add)
      echo "    ${c_green}entry: $(_claude_mergerc_drift_fmt "$(jq -c '.value' <<< "$item")")${c_reset}"
      ;;
    array-remove)
      local v
      v=$(jq -c '.value' <<< "$item")
      _claude_mergerc_drift_select '(arrayat($p) // []) | any(.[]; . == $v)' "$p" "$v"
      echo "    ${c_red}entry: $(_claude_mergerc_drift_fmt "$v")${c_reset}  ${c_dim}(from ${(j/, /)${reply[@]:t}})${c_reset}"
      ;;
  esac
}

# Print a one-line summary per item in file $1.
function _claude_mergerc_drift_list() {
  jq -r --arg r "$c_red" --arg g "$c_green" --arg y "$c_yellow" --arg z "$c_reset" "$jqlib"'
    def short: tojson | if length > 60 then .[:57] + "..." else . end;
    (.path | pathstr) as $ps
    | if .kind == "changed" then "  \($y)~ \($ps): \(.merged | short) → \(.current | short)\($z)"
      elif .kind == "added" then "  \($g)+ \($ps): \(.current | short)\($z)"
      elif .kind == "removed" then "  \($r)- \($ps): \(.merged | short)\($z)"
      elif .kind == "array-add" then "  \($g)+ \($ps)[]: \(.value | short)\($z)"
      else "  \($r)- \($ps)[]: \(.value | short)\($z)"
      end' "$1"
  echo ""
  echo "  ${c_dim}(${c_reset}${c_green}+${c_reset}${c_dim} only in settings.json   ${c_reset}${c_red}-${c_reset}${c_dim} only in fragments   ${c_reset}${c_yellow}~${c_reset}${c_dim} fragments → settings.json)${c_reset}"
}

# Show the staged change to one file: live (or nothing) vs staged, labelled
# with the live path rather than the staging copies.
function _claude_mergerc_drift_show_change() {
  local label="$1" before="$2" after="$3"
  echo ""
  echo "${c_bold}── $label${c_reset}"
  _claude_mergerc_diff "$before" "$after" "$label" "$label"
}

# Undo history: before deciding the item at queue position N, save the staging
# area so that undoing that decision can put it back exactly.
function _claude_mergerc_drift_save() {
  local h="$workdir/history/$1"
  mkdir -p "$workdir/history"
  rm -rf "$h"
  cp -R "$stage_dir" "$h"
  print -rl -- "${(@kv)staged}" > "$h.staged"
  print -rl -- "${new_files[@]}" > "$h.new"
}

function _claude_mergerc_drift_load() {
  local h="$workdir/history/$1"
  local -a kv nf
  rm -rf "$stage_dir"
  cp -R "$h" "$stage_dir"
  kv=(${(f)"$(<"$h.staged")"})
  staged=("${kv[@]}")
  nf=(${(f)"$(<"$h.new")"})
  new_files=("${nf[@]}")
}

# Undo the decision before queue position pos: restore the staging area saved
# before it, forget it (and any revisit pass queued after it), and step back.
function _claude_mergerc_drift_undo() {
  local -a parts
  pos=$((pos - 1))
  parts=("${(@ps:\t:)decisions[$pos]}")
  echo "  ${c_yellow}↶ Undid:${c_reset} ${parts[3]}"
  _claude_mergerc_drift_load "$pos"
  decisions=("${(@)decisions[1,pos-1]}")
  while (( ${#passes} )) && (( pos <= passes[-1] )); do
    queue=("${(@)queue[1,passes[-1]]}")
    passes=("${(@)passes[1,-2]}")
  done
}

function _claude_mergerc_drift() {
  local mode="$1"
  local jqlib
  jqlib=$(_claude_mergerc_jqlib)

  local items_file="$workdir/drift.jsonl"
  jq -c -n --slurpfile c "$output" --slurpfile m "$merged_json" \
    "$jqlib drift_items(\$c[0]; \$m[0]; [])" > "$items_file"
  local -a items
  items=(${(f)"$(<"$items_file")"})

  if (( ${#items} == 0 )); then
    echo "${c_green}No drift:${c_reset} settings.json matches the fragments."
    return 0
  fi

  echo "${c_bold}Drift: ${#items} item(s)${c_reset} where settings.json differs from the fragments:"
  echo ""
  _claude_mergerc_drift_list "$items_file"

  if [[ "$mode" == check ]]; then
    return 1
  fi

  local stage_dir="$workdir/stage"
  local stage_settings="$stage_dir/settings.json"
  local stage_n=0
  local -A staged snap_staged origs final_type final_text
  local -a new_files snap_new
  mkdir -p "$stage_dir" "$workdir/orig"
  cp "$output" "$stage_settings"
  cp "$output" "$workdir/orig/settings.json"

  # Items are worked through as a queue. decisions[N] records the decision
  # made at queue position N as "type<TAB>item index<TAB>summary"; undo steps
  # pos back and restores the staging area saved before that decision.
  # Skipped items can be appended for another pass; passes[] remembers the
  # queue length before each append so undo can take the append back too.
  local total=${#items} pos=1 idx item choice ps rc keys prompt rec type text color
  local adopted reverted left settings_changed before after remaining f
  local -a queue decisions passes skipped parts changed_frags
  queue=({1..$total})

  while true; do
    while (( pos <= ${#queue} )); do
      idx=${queue[$pos]}
      item=${items[$idx]}
      ps=$(jq -r "$jqlib"'
        (.path | pathstr) + (if .kind | startswith("array-") then "[] \(.value | tojson)" else "" end)
        ' <<< "$item")
      echo ""
      _claude_mergerc_drift_show "$idx" "$total" "$item"
      if (( pos > total )); then echo "    ${c_dim}(skipped earlier)${c_reset}"; fi
      _claude_mergerc_drift_save "$pos"

      keys=aris
      prompt="  $(_claude_mergerc_key a)dopt  $(_claude_mergerc_key r)evert  $(_claude_mergerc_key i)gnore  $(_claude_mergerc_key s)kip for now"
      if (( pos > 1 )); then
        keys+=u
        prompt+="  $(_claude_mergerc_key u)ndo previous"
      fi
      keys+=q
      prompt+="  $(_claude_mergerc_key q)uit: "

      while true; do
        if ! _claude_mergerc_ask_key choice "$prompt" "$keys"; then choice=eof; fi
        case "$choice" in
          a)
            _claude_mergerc_drift_adopt "$item" && rc=0 || rc=$?
            if (( rc == 0 )); then
              decisions[$pos]="adopt"$'\t'"$idx"$'\t'"$ps: $REPLY"
              break
            elif (( rc == 2 )); then
              choice=s
              decisions[$pos]="skip"$'\t'"$idx"$'\t'"$ps: skipped"
              echo "  ${c_dim}Skipped for now; you'll be offered it again at the end.${c_reset}"
              break
            fi
            # rc 1: went back; ask about this item again.
            ;;
          r)
            _claude_mergerc_drift_revert "$item"
            decisions[$pos]="revert"$'\t'"$idx"$'\t'"$ps: reverted to the fragments' value"
            break
            ;;
          i)
            decisions[$pos]="ignore"$'\t'"$idx"$'\t'"$ps: ignored"
            break
            ;;
          s)
            decisions[$pos]="skip"$'\t'"$idx"$'\t'"$ps: skipped"
            echo "  ${c_dim}Skipped for now; you'll be offered it again at the end.${c_reset}"
            break
            ;;
          u)
            break
            ;;
          q|eof)
            if [[ "$choice" == q ]] && (( pos > 1 )); then
              if ! _claude_mergerc_ask_yn "  Discard your $((pos - 1)) decision(s) and quit? [y/n] "; then
                continue
              fi
            fi
            echo "Quit. Nothing was written."
            return 0
            ;;
        esac
      done

      if [[ "$choice" == u ]]; then
        _claude_mergerc_drift_undo
        continue
      fi
      pos=$((pos + 1))
    done

    # The latest decision for each item wins (skipped items may be revisited).
    final_type=() final_text=()
    for rec in "${decisions[@]}"; do
      parts=("${(@ps:\t:)rec}")
      final_type[${parts[2]}]="${parts[1]}"
      final_text[${parts[2]}]="${parts[3]}"
    done
    skipped=() adopted=0 reverted=0 left=0
    for idx in {1..$total}; do
      case "${final_type[$idx]}" in
        adopt)  adopted=$((adopted + 1)) ;;
        revert) reverted=$((reverted + 1)) ;;
        skip)   skipped+=("$idx"); left=$((left + 1)) ;;
        *)      left=$((left + 1)) ;;
      esac
    done

    if (( ${#skipped} )); then
      echo ""
      if _claude_mergerc_ask_yn "You skipped ${#skipped} item(s). Go through them now? [y/n] "; then
        passes+=("${#queue}")
        queue+=("${skipped[@]}")
        continue
      fi
    fi

    echo ""
    echo "${c_bold}Decisions:${c_reset}"
    for idx in {1..$total}; do
      case "${final_type[$idx]}" in
        adopt)  color="$c_green" ;;
        revert) color="$c_cyan" ;;
        *)      color="$c_dim" ;;
      esac
      echo "  ${color}${final_text[$idx]}${c_reset}"
    done

    if (( adopted + reverted == 0 )); then
      echo ""
      echo "Nothing to write: nothing was adopted or reverted."
      if _claude_mergerc_ask_key choice \
          "  $(_claude_mergerc_key u)ndo previous  $(_claude_mergerc_key q)uit: " uq \
          && [[ "$choice" == u ]]; then
        _claude_mergerc_drift_undo
        continue
      fi
      return 0
    fi

    echo ""
    echo "${c_bold}Staged changes:${c_reset}"
    settings_changed=0
    if ! cmp -s "$stage_settings" "$workdir/orig/settings.json"; then
      settings_changed=1
      before="$workdir/review/settings.before" after="$workdir/review/settings.after"
      mkdir -p "$workdir/review"
      if (( yaml_mode )); then
        yq -p=json -o=yaml -P 'sort_keys(..)' "$workdir/orig/settings.json" > "$before.yaml"
        yq -p=json -o=yaml -P 'sort_keys(..)' "$stage_settings" > "$after.yaml"
        before+=.yaml after+=.yaml
      else
        jq -S '.' "$workdir/orig/settings.json" > "$before.json"
        jq -S '.' "$stage_settings" > "$after.json"
        before+=.json after+=.json
      fi
      _claude_mergerc_drift_show_change "$(_claude_mergerc_tilde "$output")" "$before" "$after"
    fi

    changed_frags=()
    _claude_mergerc_drift_fragments
    for f in "${reply[@]}"; do
      if [[ -z "${staged[$f]:-}" ]]; then continue; fi
      if [[ -n "${origs[$f]:-}" ]]; then
        if cmp -s "${origs[$f]}" "${staged[$f]}"; then continue; fi
        _claude_mergerc_drift_show_change "$(_claude_mergerc_tilde "$f")" "${origs[$f]}" "${staged[$f]}"
      else
        _claude_mergerc_drift_show_change "$(_claude_mergerc_tilde "$f") (new file)" /dev/null "${staged[$f]}"
      fi
      changed_frags+=("$f")
    done

    _claude_mergerc_drift_merge "$workdir/final.json"
    remaining=$(jq -n --slurpfile c "$stage_settings" --slurpfile m "$workdir/final.json" \
      "$jqlib [drift_items(\$c[0]; \$m[0]; [])] | length")
    echo ""
    if (( remaining == left )); then
      echo "After writing, $remaining item(s) will still drift (the ones you ignored or skipped)."
    else
      _claude_mergerc_warn "after writing, $remaining item(s) will still drift, but you left $left as they are."
      echo "         Run 'claude-mergerc -c' afterwards to see what's left." >&2
    fi

    echo ""
    echo "  $(_claude_mergerc_key w) Write changes"
    echo "  $(_claude_mergerc_key b) Back up every file it touches, then write"
    echo "  $(_claude_mergerc_key u) Undo the last decision and go back"
    echo "  $(_claude_mergerc_key q) Quit without writing"
    while true; do
      if ! _claude_mergerc_ask_key choice "Choose [w/b/u/q]: " wbuq; then
        echo "Nothing was written."
        return 0
      fi
      if [[ "$choice" == q ]]; then
        if _claude_mergerc_ask_yn "Discard all your decisions and quit without writing? [y/n] "; then
          echo "Nothing was written."
          return 0
        fi
        continue
      fi
      break
    done

    if [[ "$choice" == u ]]; then
      _claude_mergerc_drift_undo
      continue
    fi
    break
  done

  # Refuse to write over anything that changed since we read it — Claude Code
  # may have written settings.json while you were deciding.
  if ! cmp -s "$output" "$workdir/orig/settings.json"; then
    _claude_mergerc_err "$output changed while you were reviewing. Nothing was written; run again."
    return 1
  fi
  for f in "${changed_frags[@]}"; do
    if [[ -n "${origs[$f]:-}" ]]; then
      if ! cmp -s "$f" "${origs[$f]}"; then
        _claude_mergerc_err "$f changed while you were reviewing. Nothing was written; run again."
        return 1
      fi
    elif [[ -e "$f" ]]; then
      _claude_mergerc_err "$f appeared while you were reviewing. Nothing was written; run again."
      return 1
    fi
  done

  local ts
  ts=$(date +%Y%m%d%H%M%S)
  for f in "${changed_frags[@]}"; do
    if [[ "$choice" == b && -e "$f" ]]; then
      cp "$f" "$f.bak.$ts"
      echo "${c_dim}Backup → $f.bak.$ts${c_reset}"
    fi
    mkdir -p "${f:h}"
    cp "${staged[$f]}" "$f"
    echo "${c_green}Wrote${c_reset} $f"
  done
  if (( settings_changed )); then
    if [[ "$choice" == b ]]; then
      cp "$output" "$output.bak.$ts"
      echo "${c_dim}Backup → $output.bak.$ts${c_reset}"
    fi
    cp "$stage_settings" "$output"
    echo "${c_green}Wrote${c_reset} $output"
  fi
}

# On first invocation, zsh's native autoload executes this file's body — which
# only *defines* the functions above — without running the command. Call it
# explicitly so the first invocation behaves like every other one.
claude-mergerc "$@"
